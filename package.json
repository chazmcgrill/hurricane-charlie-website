{
    "name": "hurricane-charlie-website",
    "private": true,
    "description": "Hurricane Charlie Website",
    "version": "2.6.0",
    "author": "Charlie Taylor",
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "framer-motion": "^13.2.0",
        "next": "16.3.5",
        "nodemailer": "^10.0.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "typescript": "7.0.2",
        "zod": "^4.5.4"
    },
    "keywords": [
        "nextjs",
        "portfolio",
        "react",
        "gallery",
        "shop"
    ],
    "license": "MIT",
    "scripts": {
        "build": "next build",
        "check-types": "npx tsc --noEmit",
        "dev": "next dev",
        "format": "npm run prettier -- --write",
        "lint": "eslint .",
        "prepare": "husky install",
        "prettier": "prettier --ignore-path .gitignore --ignore-path .prettierignore \"**/*.+(js|json|ts|tsx)\"",
        "start": "next start",
        "test": "echo \"add some tests\"",
        "validate": "npm run check-types && npm run lint"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/chazmcgrill/hurricane-charlie-website"
    },
    "bugs": {
        "url": "https://github.com/chazmcgrill/hurricane-charlie-website/issues"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.10.0",
        "eslint-config-next": "16.3.5",
        "husky": "^9.1.7",
        "prettier": "^3.9.6",
        "sass": "^1.104.0"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": "eslint --cache --fix",
        "*.{js,ts,tsx,json}": "prettier --write"
    },
    "engines": {
        "node": "24",
        "npm": "11"
    },
    "overrides": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0"
    }
}
